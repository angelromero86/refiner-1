{
  "name": "refiner",
  "version": "0.1.2",
  "description": "Git code-review TUI with line-level staging and review threads, built on Bun + OpenTUI",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "refiner": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "install-local": "bun run scripts/install.ts",
    "install-skills": "bun run scripts/install-skills.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
